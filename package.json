{
  "name": "dayzeros-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "desktop"
  ],
  "scripts": {
    "dev": "bun run --cwd backend dev & bun run --cwd frontend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run --cwd backend build && bun run --cwd frontend build",
    "build:frontend": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "db:push": "bun run --cwd backend db:push",
    "db:generate": "bun run --cwd backend db:generate",
    "dev:desktop": "bun run --cwd desktop dev",
    "build:desktop": "bun run --cwd desktop build"
  }
}
